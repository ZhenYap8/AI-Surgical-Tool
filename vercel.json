{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "vercel_app.py",
      "routePrefix": "/api",
      "framework": "fastapi",
      "maxDuration": 30,
      "excludeFiles": ["tests/**", "requirements-dev.txt"]
    }
  }
}
